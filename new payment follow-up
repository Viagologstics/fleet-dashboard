function doGet() {
  return HtmlService.createHtmlOutput(getHtmlPortalContent())
      .setTitle('Payment Followup Portal')
      .addMetaTag('viewport', 'width=device-width, initial-scale=1')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function getPortalData() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var lastRow = sheet.getLastRow();

  if (lastRow < 5) {
    return { trips: [], customers: [], summary: [], months: [] };
  }

  // IMPORTANT: Initial page load contains NO transporter remark history.
  // This keeps the first response small and fast.
  var data = sheet.getRange(5, 1, lastRow - 4, 18).getValues();

  var trips = [];
  var summaryList = [];
  var customerNames = Object.create(null);
  var monthSet = Object.create(null);

  data.forEach(function(row) {
    var dateVal = row[0];
    var vehicle = row[1];
    var consignor = row[3] ? String(row[3]).trim() : "";
    var dcLrNo = row[4] ? String(row[4]).trim() : "";
    var customer = row[13] ? String(row[13]).trim() : "";
    var tripId = row[14] ? String(row[14]).trim() : "";
    var pending = row[15] ? Number(row[15]) : 0;
    var remarks = row[17] ? String(row[17]).trim() : "";

    var isDate = dateVal instanceof Date;
    var dateTimeObj = isDate ? dateVal.getTime() : 0;

    var dateStr = isDate
      ? Utilities.formatDate(dateVal, "GMT+5:30", "dd/MMM/yyyy")
      : String(dateVal);

    var monthKey = isDate
      ? Utilities.formatDate(dateVal, "GMT+5:30", "yyyy-MM")
      : "Unknown";

    var monthDisplay = isDate
      ? Utilities.formatDate(dateVal, "GMT+5:30", "MMM yyyy")
      : "Unknown";

    if (isDate) monthSet[monthKey] = monthDisplay;

    var primaryParty = customer || consignor || "Unknown Party";

    if (!tripId) {
      var custKey = primaryParty.replace(/\s+/g, "");
      var vehKey = vehicle ? String(vehicle).replace(/\s+/g, "") : "NA";
      var dcKey = dcLrNo ? dcLrNo.replace(/\s+/g, "") : "NADC";
      tripId = custKey + "-" + dateStr + "-" + vehKey + "-" + dcKey;
    }

    trips.push({
      id: tripId,
      label:
        "Party: " + primaryParty +
        " | DC/Ref: " + (dcLrNo || tripId) +
        " | Vehicle: " + (vehicle || "N/A") +
        " | Pending: ₹" + pending,
      dateTimeVal: dateTimeObj
    });

    summaryList.push({
      id: tripId,
      dcLrNo: dcLrNo || "-",
      customer: primaryParty,
      vehicle: vehicle || "N/A",
      pending: pending,
      status: remarks ? "✅ Updated" : "⏳ Pending Note",
      latestRemark: remarks ? remarks.split("\n")[0] : "",
      unloadedDate: dateStr,
      monthKey: monthKey,
      dateTimeVal: dateTimeObj
    });

    customerNames[primaryParty] = true;
  });

  var processedCustomers = Object.keys(customerNames)
    .map(function(name) {
      return {
        name: name,
        label: name
      };
    })
    .sort(function(a, b) {
      return a.name.localeCompare(b.name);
    });

  var sortedMonths = Object.keys(monthSet)
    .map(function(key) {
      return { key: key, name: monthSet[key] };
    })
    .sort(function(a, b) {
      return b.key.localeCompare(a.key);
    });

  return {
    trips: trips,
    customers: processedCustomers,
    summary: summaryList,
    months: sortedMonths
  };
}


/**
 * Loads transporter summary ONLY when the user opens the summary.
 * This is deliberately a separate server call so the initial page
 * does not download/process all historical remarks.
 */
function getTransporterSummary() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var lastRow = sheet.getLastRow();

  if (lastRow < 5) {
    return { customers: [], months: [] };
  }

  var data = sheet.getRange(5, 1, lastRow - 4, 18).getValues();

  var customerMap = Object.create(null);
  var monthSet = Object.create(null);

  data.forEach(function(row) {
    var dateVal = row[0];
    var consignor = row[3] ? String(row[3]).trim() : "";
    var customer = row[13] ? String(row[13]).trim() : "";
    var pending = row[15] ? Number(row[15]) : 0;
    var remarks = row[17] ? String(row[17]).trim() : "";

    var isDate = dateVal instanceof Date;
    var dateTimeObj = isDate ? dateVal.getTime() : 0;

    var dateStr = isDate
      ? Utilities.formatDate(dateVal, "GMT+5:30", "dd/MMM/yyyy")
      : String(dateVal);

    var monthKey = isDate
      ? Utilities.formatDate(dateVal, "GMT+5:30", "yyyy-MM")
      : "Unknown";

    var monthDisplay = isDate
      ? Utilities.formatDate(dateVal, "GMT+5:30", "MMM yyyy")
      : "Unknown";

    if (isDate) monthSet[monthKey] = monthDisplay;

    var primaryParty = customer || consignor || "Unknown Party";

    if (!customerMap[primaryParty]) {
      customerMap[primaryParty] = {
        name: primaryParty,
        monthBuckets: Object.create(null)
      };
    }

    var cust = customerMap[primaryParty];

    if (!cust.monthBuckets[monthKey]) {
      cust.monthBuckets[monthKey] = {
        trips: 0,
        pending: 0,
        firstTime: dateTimeObj || 0,
        lastTime: dateTimeObj || 0,
        firstDate: dateStr,
        lastDate: dateStr,
        remarks: [],
        remarkSeen: Object.create(null)
      };
    }

    var bucket = cust.monthBuckets[monthKey];

    bucket.trips++;
    bucket.pending += pending;

    if (
      dateTimeObj &&
      (!bucket.firstTime || dateTimeObj < bucket.firstTime)
    ) {
      bucket.firstTime = dateTimeObj;
      bucket.firstDate = dateStr;
    }

    if (
      dateTimeObj &&
      (!bucket.lastTime || dateTimeObj > bucket.lastTime)
    ) {
      bucket.lastTime = dateTimeObj;
      bucket.lastDate = dateStr;
    }

    if (remarks) {
      remarks.split("\n").forEach(function(line) {
        var cleanLine = line.trim();
        if (!cleanLine || bucket.remarkSeen[cleanLine]) return;

        bucket.remarkSeen[cleanLine] = true;

        var remarkTime = 0;
        var match = cleanLine.match(/\[(.*?)\]/);

        if (match && match[1]) {
          var parsed = new Date(
            match[1].split(" - ")[0]
          );

          if (!isNaN(parsed.getTime())) {
            remarkTime = parsed.getTime();
          }
        }

        bucket.remarks.push({
          text: cleanLine,
          time: remarkTime
        });
      });
    }
  });

  var customers = Object.keys(customerMap)
    .map(function(name) {
      var c = customerMap[name];

      Object.keys(c.monthBuckets).forEach(function(monthKey) {
        c.monthBuckets[monthKey].remarks.sort(function(a, b) {
          return b.time - a.time;
        });

        // Do not send internal duplicate-tracking object to browser.
        delete c.monthBuckets[monthKey].remarkSeen;
      });

      return {
        name: c.name,
        monthBuckets: c.monthBuckets
      };
    })
    .sort(function(a, b) {
      return a.name.localeCompare(b.name);
    });

  var months = Object.keys(monthSet)
    .map(function(key) {
      return {
        key: key,
        name: monthSet[key]
      };
    })
    .sort(function(a, b) {
      return b.key.localeCompare(a.key);
    });

  return {
    customers: customers,
    months: months
  };
}

function processSingleRemark(tripId, rawRemark, userName) {
  return executeMasterUpdate(tripId, rawRemark, userName, false);
}

function processBulkRemark(customerName, rawRemark, userName) {
  return executeMasterUpdate(customerName, rawRemark, userName, true);
}

function executeMasterUpdate(searchKey, rawRemark, userName, isBulk) {
  var typedRemark = String(rawRemark).trim();
  if (!typedRemark) return { success: false, message: "Remark text cannot be empty." };
  
  var timestamp = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MMM/yyyy HH:mm");
  var formattedRemark = "[" + timestamp + " - " + userName.toUpperCase().trim() + "]: " + typedRemark;
  
  var sourceUrl = "https://docs.google.com/spreadsheets/d/14df7O7yZp5dBXaNKucWAXuDAB7YWwyIr6n2_e5s5Jzg/edit";
  var sourceSs = SpreadsheetApp.openByUrl(sourceUrl);
  var sourceSheet = sourceSs.getSheetByName("trips");
  
  var sourceMasterLastRow = sourceSheet.getLastRow();
  var sourceMasterLastCol = sourceSheet.getLastColumn();
  var sourceData = sourceSheet.getRange(1, 1, sourceMasterLastRow, sourceMasterLastCol).getValues();
  
  var consignorCol = 3;  // Column D (Consignor Name) -> index 3
  var dcCol = 4;         // Column E (Dc/Lr No.) -> index 4
  var customerCol = 13;  // Column N (Customer Company) -> index 13
  var tripIdCol = 32;    // Column AG (Trip ID / Reference) -> index 32
  var targetCol = 105;   // Column DB
  
  var matchCount = 0;
  
  for (var i = 0; i < sourceData.length; i++) {
    var isMatch = false;
    
    if (isBulk) {
      var rowCust = String(sourceData[i][customerCol]).trim();
      var rowConsignor = String(sourceData[i][consignorCol]).trim();
      isMatch = (rowCust === String(searchKey).trim() || rowConsignor === String(searchKey).trim());
    } else {
      var rowTripId = String(sourceData[i][tripIdCol]).trim();
      var rowDc = String(sourceData[i][dcCol]).trim();
      isMatch = (rowTripId == String(searchKey).trim() || rowDc == String(searchKey).trim());
    }
    
    if (isMatch) {
      var sourceRow = i + 1;
      var masterCell = sourceSheet.getRange(sourceRow, targetCol + 1);
      var masterHistory = masterCell.getValue();
      
      masterCell.setValue(masterHistory !== "" ? formattedRemark + "\n" + masterHistory : formattedRemark);
      matchCount++;
      
      if (!isBulk) break;
    }
  }
  
  if (matchCount > 0) {
    return { success: true, message: "Log tracking update recorded directly into the Master Trips Sheet! Matched rows: " + matchCount };
  } else {
    return { success: false, message: "Could not find a matching record inside the Master Trips sheet for reference: " + searchKey };
  }
}

