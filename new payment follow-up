          cachedData = response;
          populateFormDropdowns();
          buildMonthCheckboxes();
          buildAuditCustomerCheckboxes();
          buildAuditDashboard();
          buildTransporterLedger();
        }).getPortalData();
      }

      function togglePivotGrid() {
        var card = document.getElementById('pivotCard');
        var content = document.getElementById('pivotContent');
        var icon = document.getElementById('pivotIcon');
        
        if (content.classList.contains('hidden')) {
          content.classList.remove('hidden');
          card.classList.remove('collapsed');
          icon.innerText = "▲";
        } else {
          content.classList.add('hidden');
          card.classList.add('collapsed');
          icon.innerText = "▼";
        }
      }

      function populateFormDropdowns() {
        if (!cachedData) return;
        var tripSelect = document.getElementById('tripSelect');
        tripSelect.innerHTML = '';
        cachedData.trips.forEach(function(t) {
          var opt = document.createElement('option');
          opt.value = t.id;
          opt.innerText = t.label;
          tripSelect.appendChild(opt);
        });
        
        var custSelect = document.getElementById('customerSelect');
        custSelect.innerHTML = '';
        cachedData.customers.forEach(function(c) {
          var opt = document.createElement('option');
          opt.value = c.name;
          opt.innerText = c.label;
          custSelect.appendChild(opt);
        });
      }

      function buildMonthCheckboxes() {
        if (!cachedData || !cachedData.months) return;
        var container = document.getElementById('monthCheckboxesContainer');
        container.innerHTML = '';
        
        if (cachedData.months.length === 0) {
          container.innerHTML = '<span style="font-size: 12px; color: #999;">No dates found.</span>';
          return;
        }

        cachedData.months.forEach(function(m) {
          var label = document.createElement('label');
          label.className = 'filter-chip';
          label.innerHTML = '<input type="checkbox" value="' + m.key + '" checked onchange="buildTransporterLedger()"> ' + m.name;
          container.appendChild(label);
        });
      }

      function buildAuditCustomerCheckboxes() {
        if (!cachedData || !cachedData.customers) return;
        var container = document.getElementById('auditCustomerCheckboxesContainer');
        container.innerHTML = '';
        
        if (cachedData.customers.length === 0) {
          container.innerHTML = '<span style="font-size: 12px; color: #999;">No customers found.</span>';
          return;
        }

        cachedData.customers.forEach(function(cust) {
          var nameUpper = cust.name.toUpperCase();
          // Check if it matches default deselection targets
          var isDefaultChecked = true;
          if (nameUpper.includes("ABLE COLD CHAIN LOGISTICS") || nameUpper.includes("NIPPON EXPRESS")) {
            isDefaultChecked = false;
          }

          var label = document.createElement('label');
          label.className = 'filter-chip';
          label.innerHTML = '<input type="checkbox" value="' + cust.name + '" ' + (isDefaultChecked ? 'checked' : '') + ' onchange="buildAuditDashboard()"> ' + cust.name;
          container.appendChild(label);
        });
      }

      function toggleAllMonths(selectState) {
        var checkboxes = document.querySelectorAll('#monthCheckboxesContainer input[type="checkbox"]');
        checkboxes.forEach(function(chk) {
          chk.checked = selectState;
        });
        buildTransporterLedger();
      }

      function toggleAllCustomers(selectState) {
        var checkboxes = document.querySelectorAll('#auditCustomerCheckboxesContainer input[type="checkbox"]');
        checkboxes.forEach(function(chk) {
          chk.checked = selectState;
        });
        buildAuditDashboard();
      }

      function filterDropdown(searchInputId, selectId) {
        var input = document.getElementById(searchInputId);
        var filter = input.value.toLowerCase();
        var select = document.getElementById(selectId);
        var options = select.options;

        for (var i = 0; i < options.length; i++) {
          var txtValue = options[i].text || options[i].innerText;
          if (txtValue.toLowerCase().indexOf(filter) > -1) {
            options[i].style.display = "";
          } else {
            options[i].style.display = "none";
          }
        }
      }

      function buildAuditDashboard() {
        if (!cachedData || !cachedData.summary) return;
        var tbody = document.querySelector('#summaryTable tbody');
        tbody.innerHTML = '';
        
        var startDate = document.getElementById('startDateFilter').value;
        var endDate = document.getElementById('endDateFilter').value;
        var startTimestamp = startDate ? new Date(startDate).setHours(0,0,0,0) : 0;
        var endTimestamp = endDate ? new Date(endDate).setHours(23,59,59,999) : 8640000000000;
        
        // Collect checked audit customers
        var checkedAuditCusts = {};
        var customerCheckboxes = document.querySelectorAll('#auditCustomerCheckboxesContainer input[type="checkbox"]:checked');
        customerCheckboxes.forEach(function(chk) {
          checkedAuditCusts[chk.value] = true;
        });
        
        var filteredRows = cachedData.summary.filter(function(row) {
          // Check date filter
          if (row.dateTimeVal > 0) {
            if (row.dateTimeVal < startTimestamp || row.dateTimeVal > endTimestamp) return false;
          }
          // Check customer filter
          if (!checkedAuditCusts[row.customer]) return false;
          
          return true;
        });
        
        if (filteredRows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; color: #999;">No records found for the selected filter criteria.</td></tr>';
          return;
        }

        filteredRows.forEach(function(row) {
          var tr = document.createElement('tr');
          var badgeClass = (row.status.includes('Updated')) ? 'badge-updated' : 'badge-pending';
          
          tr.innerHTML = "<td style='font-weight: 600; color: #1a73e8;'>" + row.dcLrNo + "</td>" +
                         "<td>" + row.id + "</td>" +
                         "<td>" + row.customer + "</td>" +
                         "<td>" + row.vehicle + "</td>" +
                         "<td style='font-weight: bold;'>₹" + row.pending + "</td>" +
                         "<td><span class='badge " + badgeClass + "'>" + row.status + "</span></td>" +
                         "<td style='color:#666;' title='" + row.latestRemark + "'>" + (row.latestRemark || '-') + "</td>" +
                         "<td style='font-weight: 500; color: #202124;'>" + row.unloadedDate + "</td>";
          tbody.appendChild(tr);
        });
      }

      function buildTransporterLedger() {
        if (!cachedData || !cachedData.customers) return;
        var tbody = document.querySelector('#transporterTable tbody');
        tbody.innerHTML = '';
        
        var checkedMonths = {};
        var checkboxes = document.querySelectorAll('#monthCheckboxesContainer input[type="checkbox"]:checked');
        checkboxes.forEach(function(chk) {
          checkedMonths[chk.value] = true;
        });
        
        var totalTrips = 0;
        var totalPending = 0;
        var displayedCustomersCount = 0;
        
        cachedData.customers.forEach(function(cust) {
          var validRecords = cust.records.filter(function(r) {
            if (r.monthKey === "Unknown") return true;
            return checkedMonths[r.monthKey];
          });
          
          if (validRecords.length === 0) return;
          
          displayedCustomersCount++;
          var custTotalPending = 0;
          
          validRecords.forEach(function(r) {
            custTotalPending += r.pending;
          });
          
          totalTrips += validRecords.length;
          totalPending += custTotalPending;
          
          var initialDate = validRecords[0].dateStr;
          var latestDate = validRecords[validRecords.length - 1].dateStr;
          
          var tr = document.createElement('tr');
          tr.innerHTML = "<td style='font-weight: 600; color: #1a73e8;'>" + cust.name + "</td>" +
                         "<td>" + validRecords.length + "</td>" +
                         "<td style='font-weight: bold; color: #b06000;'>₹" + custTotalPending + "</td>" +
                         "<td>" + initialDate + "</td>" +
                         "<td>" + latestDate + "</td>";
          tbody.appendChild(tr);
        });
        
        if (displayedCustomersCount === 0) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #999;">No records found for the selected month(s).</td></tr>';
        }
        
        document.getElementById('totalTripsCount').innerText = totalTrips;
        document.getElementById('totalOutstandingAmount').innerText = "₹" + totalPending;
      }

      function applyFilters() {
        buildAuditDashboard();
      }

      function clearDateFilter() {
        document.getElementById('startDateFilter').value = '';
        document.getElementById('endDateFilter').value = '';
        buildAuditDashboard();
      }

      function toggleModeView() {
        var mode = document.querySelector('input[name="mode"]:checked').value;
        if(mode === 'single') {
          document.getElementById('singleRowContainer').classList.remove('hidden');
          document.getElementById('bulkCustomerContainer').classList.add('hidden');
        } else {
          document.getElementById('singleRowContainer').classList.add('hidden');
          document.getElementById('bulkCustomerContainer').classList.remove('hidden');
        }
      }

      function goToScreen2() {
        var nameInput = document.getElementById('userNameInput').value.trim();
        if(!nameInput) {
          showStatus("Please supply your identity label.", false);
          return;
        }
        hideStatus();
        activeName = nameInput;
        activeMode = document.querySelector('input[name="mode"]:checked').value;
        
        document.getElementById('welcomeMsg').innerText = "Operator: " + activeName.toUpperCase() + " | [" + (activeMode === 'single' ? 'Single Row' : 'Bulk Customer') + "]";
        document.getElementById('screen1').classList.add('hidden');
        document.getElementById('screen2').classList.remove('hidden');
        toggleModeView();
      }

      function goBackToScreen1() {
        hideStatus();
        document.getElementById('screen2').classList.add('hidden');
        document.getElementById('screen1').classList.remove('hidden');
      }

      function submitFollowup() {
        var text = document.getElementById('remarkText').value;
        if(!text.trim()) {
          showStatus("Please construct a brief remark.", false);
          return;
        }
        
        showStatus("Transmitting update logs...", true);
        
        if (activeMode === 'single') {
          var tripId = document.getElementById('tripSelect').value;
          google.script.run.withSuccessHandler(handleBackendResponse).processSingleRemark(tripId, text, activeName);
        } else {
          var custName = document.getElementById('customerSelect').value;
          google.script.run.withSuccessHandler(handleBackendResponse).processBulkRemark(custName, text, activeName);
        }
      }

      function handleBackendResponse(res) {
        showStatus(res.message, res.success);
        if(res.success) { 
          document.getElementById('remarkText').value = '';
          refreshPortalGrid(); 
        }
      }

      function showStatus(msg, isSuccess) {
        var statusDiv = document.getElementById('status');
        statusDiv.innerText = msg;
        statusDiv.className = isSuccess ? 'success' : 'error';
        statusDiv.style.display = 'block';
      }
      
      function hideStatus() {
        document.getElementById('status').style.display = 'none';
      }
    </script>
  </body>
  </html>
  `;
}
