function onOpen() {
  var ui = SpreadsheetApp.getUi();
  ui.createMenu('Followup Actions')
      .addItem('💬 Add Remark Window', 'showRemarkWindow')
      .addToUi();
}

function showRemarkWindow() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var cell = sheet.getActiveCell();
  var row = cell.getRow();
  
  if (row < 5) {
    SpreadsheetApp.getUi().alert("Please select a valid row inside your trip data.");
    return;
  }
  
  var consignor = sheet.getRange(row, 4).getValue(); // Column D
  var customer = sheet.getRange(row, 14).getValue();  // Column N
  var tripId = sheet.getRange(row, 15).getValue();    // Column O
  var dcLrNo = sheet.getRange(row, 5).getValue();     // Column E
  var currentHistory = sheet.getRange(row, 18).getValue(); // Column R
  
  if (!tripId) {
    var vehicle = String(sheet.getRange(row, 2).getValue()).replace(/\s+/g, '');
    var dateVal = sheet.getRange(row, 1).getValue();
    var formattedDate = dateVal instanceof Date ? Utilities.formatDate(dateVal, "GMT+5:30", "dd/MMM") : String(dateVal);
    var custClean = customer ? String(customer).trim().replace(/\s+/g, '') : (consignor ? String(consignor).trim().replace(/\s+/g, '') : "UNKNOWN");
    var dcClean = dcLrNo ? String(dcLrNo).trim().replace(/\s+/g, '') : "NADC";
    
    tripId = custClean + "-" + formattedDate + "-" + vehicle + "-" + dcClean;
  }
  
  var ui = SpreadsheetApp.getUi();
  var promptMessage = "Consignor/Customer: " + (customer || consignor) + "\nTrip ID/Ref / DC: " + tripId + "\n\n--- Current History ---\n" + (currentHistory || "No remarks yet") + "\n\nType your new remark below:";
  var response = ui.prompt('Add Payment Followup Update', promptMessage, ui.ButtonSet.OK_CANCEL);
  
  if (response.getSelectedButton() == ui.Button.OK) {
    var userEmail = Session.getActiveUser().getEmail();
    var userName = userEmail ? userEmail.split("@")[0].toUpperCase() : "SHEET_USER";
    var result = processSingleRemark(tripId, response.getResponseText(), userName);
    ui.alert(result.success ? "Success!" : "Error", result.message, ui.ButtonSet.OK);
  }
}

